{
  "security_keywords": ["password", "credential", "security", "breach"],

  "required_fields": ["urgency"],
  "clarification_question": "How urgent is this? (low / medium / high)",
  "default_queue": "IT",
  "default_route": "CREATE_DRAFT_TICKET",

  "source_policies": {
    "shopify": {
      "required_fields": [
        "metadata.shop_domain",
        "metadata.order_id",
        "metadata.normalized.order_id",
        "metadata.normalized.shop_domain"
      ],

      "clarification_question": "Missing required Shopify order information. Please provide the missing personalization inputs.",

      "personalization_required_per_item": [
        "pet_name",
        "style"
      ],

      "default_route": "SHOPIFY_FULFILLMENT_PLAN",

      "pod_partner_rules": [
        {
          "match": {
            "sku_contains": "16x20"
          },
          "partner": "POD_B",
          "reason": "SKU contains 16x20"
        },
        {
          "match": {
            "default": true
          },
          "partner": "POD_A",
          "reason": "Default partner"
        }
      ]
    }
  }
}
