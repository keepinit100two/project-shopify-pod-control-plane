{
  "security_keywords": ["password", "credential", "security", "breach"],

  "required_fields": ["urgency"],
  "clarification_question": "How urgent is this? (low / medium / high)",
  "default_queue": "IT",
  "default_route": "CREATE_DRAFT_TICKET",

  "source_policies": {
    "shopify": {
      "required_fields": [
        "metadata.shop_domain",
        "metadata.order_id",
        "metadata.normalized.order_id",
        "metadata.normalized.shop_domain"
      ],

      "clarification_question": "Missing required Shopify order information. Please provide the missing personalization inputs.",

      "personalization_required_per_item": [
        "pet_name",
        "style"
      ],

      "default_route": "SHOPIFY_FULFILLMENT_PLAN",

      "pod_partner_rules": [
        {
          "match": {
            "sku_contains": "16x20"
          },
          "partner": "POD_B",
          "reason": "SKU contains 16x20"
        },
        {
          "match": {
            "default": true
          },
          "partner": "POD_A",
          "reason": "Default partner"
        }
      ],

      "dispatch": {
        "draft_route": "CREATE_DISPATCH_DRAFTS",
        "mode": "draft_only"
      },

      "shopify_admin_updates": {
        "REQUEST_MORE_INFO": {
          "tags_add": ["NEEDS_INFO"],
          "tags_remove": ["PLAN_CREATED", "DISPATCH_DRAFTS_READY"],
          "note_template": "Order requires more info: {reason}"
        },
        "SHOPIFY_FULFILLMENT_PLAN": {
          "tags_add": ["PLAN_CREATED"],
          "tags_remove": ["NEEDS_INFO"],
          "note_template": "Fulfillment plan created (draft). Partners selected per line item."
        },
        "CREATE_DISPATCH_DRAFTS": {
          "tags_add": ["DISPATCH_DRAFTS_READY"],
          "tags_remove": [],
          "note_template": "Dispatch drafts created (draft-only). Review before sending to partners."
        }
      }
    }
  }
}
